#!/usr/bin/env bash
# B4KFrontend pre-commit: protected-branch guard + worktree guard + secret scan
# Activate (one-time): git config core.hooksPath .githooks
# Install gitleaks: brew install gitleaks

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
CONFIG="$REPO_ROOT/.gitleaks.toml"

# ── Protected-branch guard — DEC-44/workflow.md PR Regulations ──────────────
# No direct commit to main/devtest. Bypass: git commit --no-verify (visible,
# deliberate — not meant to stop a real exception, only an accidental slip).
CURRENT_BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
if [[ "$CURRENT_BRANCH" == "main" || "$CURRENT_BRANCH" == "devtest" ]]; then
  printf '\n\033[31m❌ Direct commit to protected branch "%s" blocked.\033[0m\n' "$CURRENT_BRANCH"
  printf '   Branch first: git checkout -b fix/<slug> (or feature/, preview/)\n'
  printf '   Bypass (deliberate exceptions only): git commit --no-verify\n'
  exit 1
fi

# ── Worktree guard — DEC-44 (2026-07-22) ────────────────────────────────────
# B4KFrontend/B4KBackend code work must happen in a linked worktree, not the
# shared main checkout — confirmed collision incidents this week (branch
# swapped under a session mid-edit, uncommitted hunks from two sessions
# landing in the same file, a file silently reverted with no conflict ever
# surfacing). Bypass: git commit --no-verify.
GIT_DIR_ABS="$(git rev-parse --path-format=absolute --git-dir)"
GIT_COMMON_DIR_ABS="$(git rev-parse --path-format=absolute --git-common-dir)"
if [[ "$GIT_DIR_ABS" == "$GIT_COMMON_DIR_ABS" ]]; then
  printf '\n\033[31m❌ Commit blocked — this is the main checkout, not a git worktree.\033[0m\n'
  printf '   See B4KVault/decisions/DEC-44-mandatory-worktree-isolation.md\n'
  printf '   git worktree add ../B4KFrontend-<slug> -b fix/<slug> origin/devtest\n'
  printf '   Bypass (deliberate exceptions only): git commit --no-verify\n'
  exit 1
fi

# ── Scratch/temp file guard ──────────────────────────────────────────────────
# Catches obvious scratch/debug files accidentally left staged (e.g. a
# standalone throwaway test script forgotten before commit). Deliberately
# conservative — only clear scratch-naming patterns and editor/OS junk, never
# anything that could be a real source file (.test.ts/.spec.ts excluded).
SCRATCH_FOUND=""
while IFS= read -r staged_file; do
  [[ -z "$staged_file" ]] && continue
  base="$(basename "$staged_file")"
  if [[ "$base" =~ ^(scratch|tmp|temp|wip)[-_.] ]] || [[ "$base" == ".DS_Store" ]] || [[ "$base" == *~ ]] || [[ "$base" == *.swp ]] || [[ "$base" == *.orig ]]; then
    SCRATCH_FOUND="${SCRATCH_FOUND}  ${staged_file}\n"
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [[ -n "$SCRATCH_FOUND" ]]; then
  printf '\n\033[31m❌ Scratch/temp file(s) staged — commit blocked.\033[0m\n'
  printf "$SCRATCH_FOUND"
  printf '   If intentional: git commit --no-verify\n'
  exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  printf '\033[33m⚠️  gitleaks not installed — skipping secret scan.\033[0m\n'
  printf '   Install: brew install gitleaks\n'
  exit 0
fi

if [ ! -f "$CONFIG" ]; then
  CONFIG_FLAG=""
else
  CONFIG_FLAG="--config $CONFIG"
fi

if ! gitleaks protect --staged --redact --no-banner $CONFIG_FLAG; then
  printf '\n\033[31m❌ Secret detected. Commit blocked.\033[0m\n'
  printf '   See ../B4KVault/security/POL-incident-response.md\n'
  exit 1
fi

# ── Doc metadata scan ────────────────────────────────────────────────────────
# Scans staged .md files for sensitive metadata (paths, emails, JWTs, IPs).
# This is NOT a secrets scan — gitleaks above handles credentials.

scan_md_file() {
  local filepath="$1"
  local findings=()
  local in_fence=0
  local lineno=0

  while IFS= read -r line; do
    lineno=$(( lineno + 1 ))

    # Toggle code fence tracking
    if [[ "$line" =~ ^\`\`\` ]]; then
      if (( in_fence == 0 )); then in_fence=1; else in_fence=0; fi
      continue
    fi
    (( in_fence )) && continue

    # 1. Absolute local paths: /Users/<word>/ or /home/<word>/
    if echo "$line" | grep -qE '/(Users|home)/[A-Za-z0-9_.-]+/'; then
      if ! echo "$line" | grep -qE '/(Users|home)/(your-?name|username|user|example|path|to)/'; then
        findings+=("  $filepath:$lineno: absolute local path")
      fi
    fi

    # 2. Real email addresses
    if echo "$line" | grep -qE '\b[A-Za-z0-9._%+/-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b'; then
      if ! echo "$line" | grep -qiE '(example\.com|yourname@|user@example|@domain\.com|\[word\]@|noreply@anthropic)'; then
        findings+=("  $filepath:$lineno: real email address")
      fi
    fi

    # 3. JWT token shape
    if echo "$line" | grep -qE 'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+'; then
      findings+=("  $filepath:$lineno: JWT token shape")
    fi

    # 4. .env key=value content (non-placeholder)
    if echo "$line" | grep -qE '^[A-Z_]{3,}=.{8,}$'; then
      if ! echo "$line" | grep -qiE '=(your_|change.me|xxx|CHANGE_ME|YOUR_|<your|example|placeholder|https?://(your|example)|http://localhost)'; then
        findings+=("  $filepath:$lineno: .env key=value content")
      fi
    fi

    # 5. IP addresses (exclude safe/doc IPs)
    if echo "$line" | grep -qE '\b[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b'; then
      if ! echo "$line" | grep -qE '(127\.0\.0\.1|0\.0\.0\.0|192\.168\.|255\.255\.|10\.0\.|/path/|example)'; then
        findings+=("  $filepath:$lineno: IP address")
      fi
    fi

  done < <(git show ":$filepath" 2>/dev/null)

  printf '%s\n' "${findings[@]}"
}

DOC_FAIL=0
while IFS= read -r staged_file; do
  [[ -z "$staged_file" ]] && continue
  results=$(scan_md_file "$staged_file")
  if [[ -n "$results" ]]; then
    if (( DOC_FAIL == 0 )); then
      printf '\n\033[31m❌ Doc metadata leak detected — commit blocked.\033[0m\n'
    fi
    printf '%s\n' "$results"
    DOC_FAIL=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM | grep '\.md$')

if (( DOC_FAIL )); then
  printf '\n   Remove sensitive metadata before committing.\n'
  printf '   If false positive: adjust allowlist in .githooks/pre-commit\n'
  exit 1
fi

exit 0
