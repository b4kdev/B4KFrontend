  "help": {
    "ariaLabel": "Help page",
    "breadcrumb": "Help",
    "title": "Help & FAQ",
    "expandAriaLabel": "Expand: {question}",
    "collapseAriaLabel": "Collapse: {question}",
    "sections": {
      "gettingStarted": {
        "title": "Getting started",
        "items": {
          "q1": {
            "q": "What is B4K?",
            "a": "B4K is a K-culture travel discovery platform for foreign tourists visiting Korea. Find K-Pop venues, K-Drama filming locations, beauty spots, and more — then build your own itinerary."
          },
          "q2": {
            "q": "Do I need an account to use B4K?",
            "a": "You can explore the map without an account. Saving places, creating itineraries, and joining the leaderboard require signing in with Google."
          },
          "q3": {
            "q": "Which languages does B4K support?",
            "a": "B4K is available in Korean, English, Japanese, Chinese (Simplified & Traditional), Thai, and Portuguese (Brazil)."
          }
        }
      },
      "map": {
        "title": "Using the map",
        "items": {
          "q1": {
            "q": "How do I save a place?",
            "a": "Tap any pin on the map to open the place panel, then tap the bookmark icon to save it. Saved places appear in your Saved tab."
          },
          "q2": {
            "q": "How do I build an itinerary?",
            "a": "Open a place on the map and tap 'Add to plan' in the panel. You can add multiple stops, reorder them, and let B4K calculate the best route."
          }
        }
      },
      "account": {
        "title": "Account",
        "items": {
          "q1": {
            "q": "How do I change my profile?",
            "a": "Go to your profile (the icon at the bottom of the sidebar), then tap the edit icon to update your display name and language preference."
          },
          "q2": {
            "q": "How do I delete my account?",
            "a": "In Profile → Settings, tap 'Delete account'. Your data is held for 30 days before permanent deletion, in line with Korean privacy law (PIPA)."
          }
        }
      },
      "contact": {
        "title": "Contact",
        "desc": "Can't find what you're looking for? Reach out and we'll get back to you.",
        "ctaEmail": "Email support",
        "ctaEmailHref": "mailto:support@b4k.app"
      }
    }
  },
