  "help": {
    "ariaLabel": "幫助頁面",
    "breadcrumb": "幫助",
    "title": "幫助與常見問題",
    "expandAriaLabel": "展開：{question}",
    "collapseAriaLabel": "收合：{question}",
    "sections": {
      "gettingStarted": {
        "title": "新手指南",
        "items": {
          "q1": {
            "q": "B4K是什麼？",
            "a": "B4K是一個為造訪韓國的外國遊客打造的K文化旅行發現平台。找到K-Pop場館、K-Drama拍攝地、美妝景點等等 — 接著規劃屬於你自己的行程。"
          },
          "q2": {
            "q": "使用B4K需要帳戶嗎？",
            "a": "你可以不需要帳戶就瀏覽地圖。收藏地點、建立行程與參與排行榜則需要使用Google登入。"
          },
          "q3": {
            "q": "B4K支援哪些語言？",
            "a": "B4K支援韓文、英文、日文、中文（簡體與繁體）、泰文與葡萄牙文（巴西）。"
          }
        }
      },
      "map": {
        "title": "使用地圖",
        "items": {
          "q1": {
            "q": "如何收藏地點？",
            "a": "點擊地圖上的任意圖釘以開啟地點面板，接著點擊書籤圖示即可收藏。收藏的地點會出現在你的收藏分頁中。"
          },
          "q2": {
            "q": "如何建立行程？",
            "a": "在地圖上開啟一個地點，點擊面板中的「加入行程」。你可以新增多個地點、重新排序，並讓B4K為你計算最佳路線。"
          }
        }
      },
      "account": {
        "title": "帳戶",
        "items": {
          "q1": {
            "q": "如何修改我的個人主頁？",
            "a": "前往你的個人主頁（側邊欄底部的圖示），點擊編輯圖示以更新你的顯示名稱與語言偏好。"
          },
          "q2": {
            "q": "如何刪除我的帳戶？",
            "a": "在個人主頁 → 設定中，點擊「刪除帳戶」。依據韓國個人資料保護法（PIPA），你的資料將保留30天後才會永久刪除。"
          },
          "q3": {
            "q": "如何變更我的密碼？",
            "a": "如果你以電子郵件註冊，可前往個人主頁 → 設定更新密碼。如果你使用Google、Apple或Microsoft登入，請透過該服務商管理密碼 — B4K不會儲存它。"
          }
        }
      },
      "contact": {
        "title": "聯絡我們",
        "desc": "找不到你需要的內容？歡迎與我們聯絡，我們會盡快回覆。",
        "ctaEmail": "聯絡支援信箱",
        "ctaEmailHref": "mailto:support@b4korea.com",
        "emailAddress": "support@b4korea.com",
        "copyEmail": "複製電子郵件地址",
        "copyEmailCopied": "已複製",
        "copyEmailAriaLabel": "複製電子郵件地址到剪貼簿"
      },
      "getting-started": {
        "title": "新手指南",
        "items": {
          "q1": {
            "q": "B4K是什麼？",
            "a": "B4K是一個為造訪韓國的外國遊客打造的K文化旅行發現平台。在互動地圖上探索K-Pop場館、K-Drama拍攝地、K-Beauty景點與K-Culture地標，接著規劃屬於你自己的旅行計畫。"
          },
          "q2": {
            "q": "如何建立帳戶？",
            "a": "使用電子郵件與密碼註冊，或使用Google、Apple、Microsoft繼續。沒有獨立的新手引導流程 — 註冊後你會直接進入首頁。"
          },
          "q3": {
            "q": "支援哪些語言？",
            "a": "B4K支援韓文、英文、日文、中文（簡體與繁體）、泰文與巴西葡萄牙文。你可以隨時在個人主頁設定中變更語言。"
          }
        }
      },
      "planning": {
        "title": "行程規劃",
        "items": {
          "q1": {
            "q": "如何建立旅行行程？",
            "a": "在地圖上開啟一個地點並加入你的行程。新增地點、重新排序，每段行程都會顯示預估交通時間。滿意後點擊儲存行程。你也可以請AI助理為你草擬一份行程。"
          },
          "q2": {
            "q": "我可以不註冊帳戶使用B4K嗎？",
            "a": "可以。你可以以訪客身分瀏覽地圖並建立行程 — 草稿會儲存在瀏覽器中，重新整理頁面後仍會保留。你只需要在點擊儲存行程時登入，草稿會自動轉移到你的帳戶。"
          },
          "q3": {
            "q": "一份行程可包含的地點數量有上限嗎？",
            "a": "單一行程最多可包含40個地點。達到上限後，加入按鈕會被停用並顯示提示訊息。應用程式內沒有付款功能 — 合作行程僅連結至合作夥伴的網站。"
          }
        }
      },
      "saved": {
        "title": "收藏",
        "items": {
          "q1": {
            "q": "如何收藏地點？",
            "a": "從地圖上開啟任意地點，點擊書籤圖示。收藏的地點會出現在你的收藏分頁中，你可以在同一個清單中瀏覽全部內容。"
          },
          "q2": {
            "q": "資料夾是什麼？",
            "a": "資料夾可讓你將收藏的地點整理成單層分組 — 例如依城市或興趣建立一個資料夾。資料夾僅適用於收藏的地點；收藏的行程則統一顯示在單一清單中。"
          },
          "q3": {
            "q": "如何從收藏的地點產生行程？",
            "a": "在收藏分頁中，用核取方塊選擇你想要的地點，接著選擇產生行程。B4K會將它們安排成一條建議路線，並開啟新行程供你微調。"
          }
        }
      },
      "technical": {
        "title": "技術問題",
        "items": {
          "q1": {
            "q": "地圖無法載入。",
            "a": "請先嘗試重新整理頁面。如果地圖仍無法顯示，請檢查你的網路連線，並停用可能干擾地圖的廣告或指令碼封鎖工具。如果問題仍未解決，請透過下方電子郵件與我們聯絡。"
          },
          "q2": {
            "q": "應用程式語言不正確。",
