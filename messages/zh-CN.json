  "help": {
    "ariaLabel": "帮助页面",
    "breadcrumb": "帮助",
    "title": "帮助与常见问题",
    "expandAriaLabel": "展开：{question}",
    "collapseAriaLabel": "收起：{question}",
    "sections": {
      "gettingStarted": {
        "title": "新手指南",
        "items": {
          "q1": {
            "q": "B4K是什么？",
            "a": "B4K是一个面向访问韩国的外国游客的K文化旅行发现平台。发现K-Pop场馆、K-Drama拍摄地、美容打卡地等 — 然后规划属于你自己的行程。"
          },
          "q2": {
            "q": "使用B4K需要账户吗？",
            "a": "你可以无需账户浏览地图。收藏地点、创建行程和参与排行榜需要使用Google登录。"
          },
          "q3": {
            "q": "B4K支持哪些语言？",
            "a": "B4K支持韩语、英语、日语、中文（简体和繁体）、泰语和葡萄牙语（巴西）。"
          }
        }
      },
      "map": {
        "title": "使用地图",
        "items": {
          "q1": {
            "q": "如何收藏地点？",
            "a": "点击地图上的任意图钉以打开地点面板，然后点击书签图标进行收藏。收藏的地点会出现在你的收藏标签页中。"
          },
          "q2": {
            "q": "如何创建行程？",
            "a": "在地图上打开一个地点，点击面板中的「加入行程」。你可以添加多个地点、重新排序，让B4K为你计算最佳路线。"
          }
        }
      },
      "account": {
        "title": "账户",
        "items": {
          "q1": {
            "q": "如何修改我的个人主页？",
            "a": "前往你的个人主页（侧边栏底部的图标），点击编辑图标以更新你的显示名称和语言偏好。"
          },
          "q2": {
            "q": "如何删除我的账户？",
            "a": "在个人主页 → 设置中，点击「删除账户」。根据韩国个人信息保护法（PIPA），你的数据将保留30天后才会被永久删除。"
          },
          "q3": {
            "q": "如何修改我的密码？",
            "a": "如果你使用邮箱注册，可前往个人主页 → 设置更新密码。如果你使用Google、Apple或Microsoft登录，请通过该服务商管理密码 — B4K不会存储它。"
          }
        }
      },
      "contact": {
        "title": "联系我们",
        "desc": "没有找到你需要的内容？请联系我们，我们会尽快回复。",
        "ctaEmail": "联系支持邮箱",
        "ctaEmailHref": "mailto:support@b4korea.com",
        "emailAddress": "support@b4korea.com",
        "copyEmail": "复制邮箱地址",
        "copyEmailCopied": "已复制",
        "copyEmailAriaLabel": "复制邮箱地址到剪贴板"
      },
      "getting-started": {
        "title": "新手指南",
        "items": {
          "q1": {
            "q": "B4K是什么？",
            "a": "B4K是一个面向访问韩国的外国游客的K文化旅行发现平台。在互动地图上探索K-Pop场馆、K-Drama拍摄地、K-Beauty打卡地和K-Culture地标，然后规划属于你自己的旅行计划。"
          },
          "q2": {
            "q": "如何创建账户？",
            "a": "使用邮箱和密码注册，或使用Google、Apple、Microsoft继续。没有单独的新手引导流程 — 注册后你会直接进入首页。"
          },
          "q3": {
            "q": "支持哪些语言？",
            "a": "B4K支持韩语、英语、日语、中文（简体和繁体）、泰语和巴西葡萄牙语。你可以随时在个人主页设置中更改语言。"
          }
        }
      },
      "planning": {
        "title": "行程规划",
        "items": {
          "q1": {
            "q": "如何创建旅行行程？",
            "a": "在地图上打开一个地点并将其加入行程。添加地点、重新排序，每段行程都会显示预计所需时间。满意后点击保存行程。你也可以让AI助手为你起草一份行程。"
          },
          "q2": {
            "q": "我可以不注册账户使用B4K吗？",
            "a": "可以。你可以以访客身份浏览地图并创建行程 — 草稿会保存在浏览器中，刷新页面后仍会保留。只有在点击保存行程时才需要登录，你的草稿会自动转移到你的账户中。"
          },
          "q3": {
            "q": "一个行程可以包含的地点数量有上限吗？",
            "a": "单个行程最多可包含40个地点。达到上限后，添加按钮将被禁用并显示提示信息。应用内没有付款功能 — 合作行程仅链接至合作伙伴的网站。"
          }
        }
      },
      "saved": {
        "title": "收藏",
        "items": {
          "q1": {
            "q": "如何收藏地点？",
            "a": "从地图上打开任意地点，点击书签图标。收藏的地点会出现在你的收藏标签页中，你可以在一个列表中浏览全部内容。"
          },
          "q2": {
            "q": "文件夹是什么？",
            "a": "文件夹可让你将收藏的地点整理为单层分组 — 例如按城市或兴趣建立一个文件夹。文件夹仅适用于收藏的地点；收藏的行程则统一显示在一个扁平列表中。"
          },
          "q3": {
            "q": "如何从收藏的地点生成行程？",
            "a": "在收藏标签页中，用复选框选择你想要的地点，然后选择生成行程。B4K会将它们安排成一条建议路线，并打开新行程供你微调。"
          }
        }
      },
      "technical": {
        "title": "技术问题",
        "items": {
          "q1": {
            "q": "地图无法加载。",
            "a": "请先尝试刷新页面。如果地图仍无法显示，请检查你的网络连接，并禁用可能干扰地图的广告或脚本拦截器。如果问题仍未解决，请通过下方邮箱联系我们。"
          },
          "q2": {
            "q": "应用语言不正确。",
            "a": "B4K会根据你的浏览器设置选择语言，如果不支持你的语言则默认使用英语。如需手动设置，请打开个人主页 → 设置，选择你偏好的语言。"
          },
          "q3": {
            "q": "如何反馈问题？",
            "a": "使用下方联系方式部分的邮箱地址来报告错误或发送反馈。请说明你当时在做什么、你的设备和浏览器信息，以便我们更快提供帮助。"
          }
        }
      }
    },
