# B4K Frontend — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# ─── NextAuth ───────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                        # openssl rand -base64 32

# ─── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                       # console.cloud.google.com
GOOGLE_CLIENT_SECRET=

# ─── Apple OAuth ────────────────────────────────────────────────────────────
APPLE_CLIENT_ID=                        # developer.apple.com → Identifiers → Services ID
APPLE_CLIENT_SECRET=                    # Generated JWT signed with your Apple key

# ─── Microsoft / Azure AD OAuth ─────────────────────────────────────────────
AZURE_AD_CLIENT_ID=                     # portal.azure.com → App registrations
AZURE_AD_CLIENT_SECRET=                 # portal.azure.com → App registrations → Certificates & secrets

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=               # https://<project>.supabase.co
SUPABASE_URL=                           # server-side alias — required by lib/auth.ts SupabaseAdapter
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # Settings → API → anon public
SUPABASE_SERVICE_ROLE_KEY=              # Settings → API → service_role (keep secret)

# ─── Naver Maps ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your-naver-client-id-here   # console.ncloud.com → Application → Client ID
NAVER_MAP_CLIENT_SECRET=your_naver_map_client_secret        # console.ncloud.com → Application → Client Secret (server-side)

# ─── Cloudinary ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your_cloudinary_api_key                  # Cloudinary console → Settings → API Keys
CLOUDINARY_API_SECRET=your_cloudinary_api_secret            # Cloudinary console → Settings → API Keys (keep secret)

# ─── TMAP ────────────────────────────────────────────────────────────────────
TMAP_API_KEY=your_tmap_api_key                              # tmap.sktelecom.com → App Key

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_min_32_chars                     # openssl rand -base64 32

# ─── Upstash Redis (rate limiting) ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io               # console.upstash.com → REST URL
UPSTASH_REDIS_REST_TOKEN=                                   # console.upstash.com → REST Token

# ─── Analytics (required for LGL_04 cookie consent) ─────────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX                 # analytics.google.com → Admin → Data Streams → Measurement ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=                             # clarity.microsoft.com → Settings → Overview → Project ID
