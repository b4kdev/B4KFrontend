# B4K Frontend — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# ─── Site (SEO — sitemap/robots/OG absolute URLs) ──────────────────────────
NEXT_PUBLIC_SITE_URL=https://b4k.app  # production domain, no trailing slash

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=               # https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # Settings → API → anon public
SUPABASE_SERVICE_ROLE_KEY=              # Settings → API → service_role (keep secret — server-side only)

# ─── Naver Maps ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=        # console.ncloud.com → Application → Client ID
NAVER_MAP_CLIENT_SECRET=               # console.ncloud.com → Application → Client Secret (server-side)

# ─── Cloudinary ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=      # Cloudinary console → Settings → Cloud Name
CLOUDINARY_API_KEY=                    # Cloudinary console → Settings → API Keys
CLOUDINARY_API_SECRET=                 # Cloudinary console → Settings → API Keys (keep secret)

# ─── TMAP ────────────────────────────────────────────────────────────────────
TMAP_API_KEY=                          # tmap.sktelecom.com → App Key (server-side)

# ─── Upstash Redis (rate limiting) ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL=                # console.upstash.com → REST URL
UPSTASH_REDIS_REST_TOKEN=              # console.upstash.com → REST Token (keep secret)

# ─── Analytics (required for LGL_04 cookie consent) ─────────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=        # analytics.google.com → Admin → Data Streams → Measurement ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=        # clarity.microsoft.com → Settings → Overview → Project ID
