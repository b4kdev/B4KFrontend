# B4K Frontend — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# ─── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.b4korea.com    # production domain, no trailing slash

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=                        # https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=                   # Settings → API → anon/publishable key

# ─── BFF (Supabase Edge Functions) ──────────────────────────────────────────
API_URL=                                         # https://<project>.supabase.co/functions/v1/api (server-side — app/api/* routes)
NEXT_PUBLIC_API_URL=                             # same value, exposed client-side — used by the map (lib/api.ts calls the BFF directly)

# ─── Naver Maps ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=                 # console.ncloud.com → Application → Client ID

# ─── Upstash Redis (rate limiting) ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL=                          # console.upstash.com → REST URL
UPSTASH_REDIS_REST_TOKEN=                        # console.upstash.com → REST Token (keep secret)

# ─── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=                  # analytics.google.com → Admin → Data Streams → Measurement ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=                  # clarity.microsoft.com → Settings → Overview → Project ID

# ─── Sentry (error tracking) ───────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=                          # sentry.io → project → Client Keys (DSN). PII-scrubbed, see instrumentation-client.ts

# ─── Maintenance mode ───────────────────────────────────────────────────────
MAINTENANCE_MODE=0                               # 1 = gate all Production traffic behind 503 maintenance page. Never gates Preview deploys. Requires redeploy to take effect either way.
MAINTENANCE_BYPASS_TOKEN=                        # random secret, e.g. `openssl rand -hex 32` — never commit the real value. Visit /api/maintenance-bypass?token=<value> to get past the gate.
